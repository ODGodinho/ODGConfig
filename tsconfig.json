{
    "compilerOptions": {
        "baseUrl": ".",
        "outDir": "./dist",
        "paths": {
            "#types/*": [ "./@types/*" ],
            "@interfaces": [ "./src/interfaces" ],
            "@interfaces/*": [ "./src/interfaces/*" ],
            "~/*": [ "./src/*" ]
        },
        "rootDirs": [
            ".",
            "./src"
        ],
        "typeRoots": [
            "./src/@types",
            "node_modules/@types",
            "./node_modules"
        ],
        "types": [ "node", "vitest/globals" ]
    },
    "exclude": [
        "node_modules/",
        "dist/"
    ],
    "extends": "@odg/tsconfig/tsconfig.node.json",
    "include": [ "." ]
}
